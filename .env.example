# Which Jev backend to use: "openrouter" (default, verified, no waitlist)
# or "direct" (TypeSafe's own console API, early-access/waitlisted, NOT
# verified against first-party TypeSafe docs — see src/jev-client.mjs).
# JEV_PROVIDER=openrouter

# --- openrouter provider ---
# A normal OpenRouter key — https://openrouter.ai/keys. No waitlist.
OPENROUTER_API_KEY=

# --- direct provider ---
# Requires TypeSafe console access — https://console.typesafe.ai/settings/keys
# Only used when JEV_PROVIDER=direct.
TYPESAFE_API_KEY=

# Host-harness models (Claude Code, Cursor, Codex, etc.) are used through
# the harness's own existing access — no separate provider keys required
# for those, regardless of which Jev provider above you use.

# Optional overrides (defaults shown)
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=~typesafe/jev-latest        # direct provider default differs: jev-latest
# JEV_CONFIDENCE_HIGH=0.55
# JEV_CONFIDENCE_MEDIUM=0.35
# JEV_FALLBACK_PROFILE_ID=
